{
  "name": "paveldotsoy.github.io",
  "version": "0.1.4",
  "description": "Simple landing page and blog",
  "main": "index.js",
  "scripts": {
    "build": "npx @11ty/eleventy",
    "build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
    "build-ghpages": "npx @11ty/eleventy --input=./src/",
    "start": "npx @11ty/eleventy --serve --quiet",
    "start-ghpages": "npx @11ty/eleventy --serve --quiet",
    "debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
    "debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
    "benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "eleventy-plugin-seo": "^0.5.2",
    "html-minifier-terser": "^7.2.0",
    "luxon": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paveldotsoy/paveldotsoy.github.io.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/paveldotsoy/paveldotsoy.github.io/issues"
  },
  "homepage": "https://github.com/paveldotsoy/paveldotsoy.github.io#readme",
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-jinja-template": "^2.0.0"
  }
}
